# Environment / secrets
.env
.env.*
# …but keep every committed template. Real secrets never end in ".example",
# and without this the deploy/ templates are silently ignored.
!*.example

# Dependencies
/vendor/
composer.lock

# Runtime storage
/storage/logs/*
!/storage/logs/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/thumbnails/
/storage/uploads/thumbnails/*
!/storage/uploads/thumbnails/.gitkeep

# Public uploads fallback (if used)
/public/uploads/*
!/public/uploads/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.log
