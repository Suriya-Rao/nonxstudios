# ---------------------------------------------------------------------------
# NONXSTUDIOS — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

APP_NAME="NONXSTUDIOS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# A long random string. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me-to-a-64-char-random-hex-string

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nonxstudios
DB_USER=nonx_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_NAME=nonx_session
SESSION_LIFETIME=7200
# Set true in production when served over HTTPS
SESSION_SECURE=false

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_MAX_BYTES=8388608
UPLOAD_ALLOWED=mime:image/jpeg,image/png,image/webp,image/avif

# ---------------------------------------------------------------------------
# Contact form anti-spam
# ---------------------------------------------------------------------------
CONTACT_RATE_LIMIT=3
CONTACT_RATE_WINDOW=900
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=900

# Headers carrying the real client IP, in priority order. Leave BLANK when the
# site is served directly by Apache — otherwise a visitor can send these
# headers themselves and forge an IP to bypass the rate limiter. Set to
# "CF-Connecting-IP" when traffic arrives through a Cloudflare Tunnel, or
# "X-Forwarded-For" behind a load balancer / reverse proxy.
TRUSTED_IP_HEADERS=

# ---------------------------------------------------------------------------
# SMTP (optional). Leave MAIL_ENABLED=false to skip email notifications;
# inquiries are still stored in the database.
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=studio@example.com
MAIL_FROM_NAME="NONXSTUDIOS"
MAIL_TO_ADDRESS=studio@example.com

# ---------------------------------------------------------------------------
# Analytics (optional, OFF by default).
#
# Leave ANALYTICS_PROVIDER blank and the site sends nothing anywhere: no
# script tag is emitted and the Content-Security-Policy is unchanged.
#
#   plausible | fathom | umami | ga4
#
# ANALYTICS_ID is your own site/measurement ID — never a value from a template.
# ANALYTICS_HOST is only used by self-hosted providers (plausible, umami) and
# takes the base URL, e.g. https://stats.example.com
#
# ANALYTICS_REQUIRE_CONSENT overrides the provider default. It is true for GA4
# (which sets cookies) and false for the cookieless providers. Set it to true
# if your jurisdiction requires opt-in regardless of the tool.
# ---------------------------------------------------------------------------
ANALYTICS_PROVIDER=
ANALYTICS_ID=
ANALYTICS_HOST=
ANALYTICS_REQUIRE_CONSENT=
